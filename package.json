{
  "name": "dsh-conflict-doctor",
  "version": "0.1.0",
  "description": "DSH plugin conflict governance: builds a live capability graph of the running Loader profile, detects cross-plugin conflicts (duplicate loader rows, tool-id collisions, services a plugin waits for forever, dangling disables, version skew), and emits the exact patch to fix each one. · DSH 插件冲突诊断与修复建议：把「插件为什么不生效 / 谁和谁撞了」变成一条可执行结论。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "conflict-doctor": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./schema/audit-report.schema.json": "./schema/audit-report.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "schema",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/run.mjs",
    "check": "node test/check-metadata.mjs && node test/check-version.mjs && node test/check-tarball.mjs && node test/check-entry.mjs && node test/check-schema.mjs && node test/check-golden.mjs && node test/check-perf.mjs",
    "check:metadata": "node test/check-metadata.mjs",
    "check:version": "node test/check-version.mjs",
    "check:tarball": "node test/check-tarball.mjs",
    "check:entry": "node test/check-entry.mjs",
    "check:schema": "node test/check-schema.mjs",
    "check:golden": "node test/check-golden.mjs",
    "check:perf": "node test/check-perf.mjs",
    "audit": "node lib/cli.js",
    "format": "prettier --write \"**/*.{ts,js,mjs,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,md,json,yml}\"",
    "prepublishOnly": "pnpm build && pnpm test && node test/check-metadata.mjs && node test/check-version.mjs && node test/check-tarball.mjs && node test/check-entry.mjs && node test/check-golden.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin-conflict",
    "conflict-detection",
    "diagnostics",
    "capability-graph",
    "doctor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ven314/dsh-conflict-doctor.git"
  },
  "homepage": "https://github.com/ven314/dsh-conflict-doctor#readme",
  "bugs": {
    "url": "https://github.com/ven314/dsh-conflict-doctor/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.0-rc.6 <0.3.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "semver": "^7.6.0",
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.5.8",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.6": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
